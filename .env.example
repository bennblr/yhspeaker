# --- Платформа (панель управления серверами) ---
# Панель слушает localhost; наружу её публикует Caddy.
PLATFORM_PORT=4100
PLATFORM_BIND=127.0.0.1

# Домен самой панели, например admin.example.com.
# На него тоже нужна A-запись, и его нельзя привязать к серверу-арендатору.
PLATFORM_HOST=admin.example.com

# Здесь лежат platform.json, пароли серверов и данные всех арендаторов.
PLATFORM_DATA_DIR=./platform-data

# Обязательны в production. Сгенерируйте две разные строки:
#   openssl rand -hex 32
PLATFORM_JWT_SECRET=change-me-platform-jwt-secret
PLATFORM_SECRET_KEY=change-me-platform-encryption-key

# Вход в панель платформы. Пароль минимум 8 символов, лучше длиннее.
PLATFORM_ADMIN_LOGIN=admin
PLATFORM_ADMIN_PASSWORD=change-me-strong-password

# --- Сеть / WebRTC ---
# Публичный IP VPS. Без него голос не будет слышен из интернета.
ANNOUNCED_IP=127.0.0.1
# Пул HTTP-портов для серверов-арендаторов (наружу не публикуются).
PLATFORM_HTTP_PORT_START=4200
PLATFORM_HTTP_PORT_END=4299
# Пул UDP/TCP-портов mediasoup, делится на блоки по серверам.
PLATFORM_RTC_POOL_START=40000
PLATFORM_RTC_POOL_END=40999
# Лимит участников по умолчанию для новых серверов (1–150).
# Каждому голосовому участнику выделяется 2 порта из пула RTC.
PLATFORM_DEFAULT_MAX_PARTICIPANTS=50

# --- Гости (значения по умолчанию для новых серверов) ---
ALLOW_GUESTS=true
GUEST_INVITE_REQUIRED=false

# --- Доверять X-Forwarded-For (за Caddy/Nginx) ---
PLATFORM_TRUST_PROXY=true

# --- Одиночный сервер без платформы (npm start) ---
# Эти переменные нужны только если запускаете server/dist/index.js напрямую.
# PORT=4000
# HOST=0.0.0.0
# SERVER_NAME=YHSpeak
# DATA_DIR=./data
# JWT_SECRET=change-me-to-a-long-random-string
# RTC_MIN_PORT=40000
# RTC_MAX_PORT=40500
# MAX_PARTICIPANTS=150
