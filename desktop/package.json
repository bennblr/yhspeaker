{
  "name": "@tsds/desktop",
  "version": "1.0.2",
  "private": true,
  "description": "LA2Speak desktop client for Windows",
  "author": "LA2Speak",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.la2speak.client",
    "productName": "LA2Speak",
    "beforeBuild": "before-build.js",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server-url.js",
      "launcher.html",
      "launcher.js",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../node_modules/uiohook-napi",
        "to": "ptt/node_modules/uiohook-napi",
        "filter": [
          "dist/**/*",
          "prebuilds/win32-x64/**/*",
          "package.json",
          "LICENSE"
        ]
      },
      {
        "from": "../node_modules/node-gyp-build",
        "to": "ptt/node_modules/node-gyp-build"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "LA2Speak-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LA2Speak"
    }
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  }
}
