{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Локальные окна лаунчера и оверлея",
  "windows": ["launcher", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
